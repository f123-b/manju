# 留空时使用本地演示生成器，镜头会在约 2.2 秒后完成。
# 接入实际视频平台时填写下面三项：
SHORT_DRAMA_PROVIDER_URL=
SHORT_DRAMA_PROVIDER_API_KEY=
SHORT_DRAMA_PROVIDER_NAME=External Video API
SHORT_DRAMA_PROVIDER_MODEL=
SHORT_DRAMA_ESTIMATED_COST=0.73
# 默认发送 Authorization: Bearer <key>；有些平台可改成 X-API-Key，并把前缀留空
# SHORT_DRAMA_PROVIDER_AUTH_HEADER=X-API-Key
# SHORT_DRAMA_PROVIDER_AUTH_PREFIX=

# 可选：修改本地数据库位置或演示延迟
# SHORT_DRAMA_DB=E:/短剧助手/data/short-drama.sqlite3
# SHORT_DRAMA_DEMO_DELAY=2.2
